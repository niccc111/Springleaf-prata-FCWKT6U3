# Base URL of the ROE API. Leave blank to use the Vite dev-server proxy
# (see vite.config.ts) or a same-origin deployment behind nginx.
VITE_API_BASE_URL=

# Map tiles. With none set the app renders a self-contained offline basemap so
# routes, stops, and depots are always visible without credentials.
#
# Raster tiles (simplest):
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=© OpenStreetMap contributors
#
# Or a full MapLibre vector style (takes precedence):
# VITE_MAP_STYLE_URL=https://tiles.example.com/styles/streets/style.json
