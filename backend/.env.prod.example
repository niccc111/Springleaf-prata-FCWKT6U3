# ---------------------------------------------------------------------------
# Route Optimisation Engine — PRODUCTION configuration template
#
#   cp backend/.env.prod.example backend/.env.prod
#   # then fill in every value marked CHANGE_ME
#
# docker-compose.prod.yml derives DATABASE_URL / REDIS_URL / CELERY_* from
# POSTGRES_* below, so you do not set those connection strings here.
# ---------------------------------------------------------------------------

ENVIRONMENT=production
DEBUG=false
# Operating region timezone. Vehicle operating hours are read as wall-clock
# times in this zone; order time windows stay absolute (UTC).
BUSINESS_TIMEZONE=Asia/Singapore

# Public origin(s) the browser loads the app from. Comma-separate multiple.
# Example: https://roe.example.com  or  http://<your-lightsail-static-ip>
CORS_ORIGINS=CHANGE_ME_https://your-domain-or-ip

# --- Datastore credentials (used to build the internal connection URLs) ----
POSTGRES_USER=roe
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=roe

# --- Cache -----------------------------------------------------------------
REDIS_ENABLED=true

# --- Authentication --------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_run_the_generator_above
JWT_ALGORITHM=HS256
JWT_ISSUER=roe
JWT_AUDIENCE=roe-api
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_HOURS=24
# MUST be false in production. The app refuses to boot otherwise.
AUTH_DISABLED=false

# Seed accounts, created only when the users table is empty.
BOOTSTRAP_ADMIN_EMAIL=admin@your-domain.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_strong_admin_password
BOOTSTRAP_DISPATCHER_EMAIL=dispatcher@your-domain.com
BOOTSTRAP_DISPATCHER_PASSWORD=CHANGE_ME_strong_dispatcher_password

# --- External integrations (mock | http) -----------------------------------
# Leave as "mock" to run end-to-end without third-party systems.
OMS_ADAPTER=mock
# OMS_BASE_URL=https://oms.example.com/api
# OMS_API_KEY=
OMS_POLL_INTERVAL_SECONDS=15
OMS_UNAVAILABLE_THRESHOLD_SECONDS=60

FMS_ADAPTER=mock
# FMS_BASE_URL=https://fms.example.com/api
# FMS_API_KEY=
FMS_POLL_INTERVAL_SECONDS=15
FMS_UNAVAILABLE_THRESHOLD_SECONDS=30

# Geocoding + road-network travel-time matrix (mock | http | google | osrm | mapbox).
MAPPING_ADAPTER=mapbox
# MAPPING_BASE_URL=https://valhalla.example.com
# MAPPING_API_KEY=
MAPPING_UNAVAILABLE_THRESHOLD_SECONDS=30
MAPPING_RETRY_INTERVAL_SECONDS=60
# Google Maps Platform (only if MAPPING_ADAPTER=google).
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_REGION=sg
# OSRM server (only if MAPPING_ADAPTER=osrm). Self-host for production.
OSRM_BASE_URL=https://router.project-osrm.org
# Mapbox token (only if MAPPING_ADAPTER=mapbox). Use a secret sk. token.
MAPBOX_ACCESS_TOKEN=CHANGE_ME_mapbox_access_token
MAPBOX_COUNTRY=sg

DELIVERY_PLATFORM_ADAPTER=mock
# DELIVERY_PLATFORM_BASE_URL=https://delivery.example.com/api
# DELIVERY_PLATFORM_API_KEY=

# --- Optimisation ----------------------------------------------------------
OPTIMISATION_WALL_CLOCK_LIMIT_SECONDS=120
OPTIMISATION_SOLVER_LIMIT_SECONDS=110
OPTIMISATION_PROGRESS_INTERVAL_SECONDS=3
DEFAULT_SERVICE_DURATION_MIN=10
AVERAGE_SPEED_KMH=32

# --- Retention -------------------------------------------------------------
AUDIT_RETENTION_DAYS=365
ROUTE_RETENTION_DAYS=365
ALERT_RETENTION_DAYS=90
