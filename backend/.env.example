# ---------------------------------------------------------------------------
# Route Optimisation Engine — backend configuration
#
# Every external integration defaults to a local mock adapter, so the system
# runs end to end with no third-party credentials. Switch an adapter to "http"
# and supply its base URL to talk to a real system.
# ---------------------------------------------------------------------------

ENVIRONMENT=local
DEBUG=false
CORS_ORIGINS=http://localhost:5173

# --- Database & cache ------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://roe:roe@localhost:5432/roe
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true

# --- Celery ----------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Authentication --------------------------------------------------------
# CHANGE THIS IN ANY DEPLOYED ENVIRONMENT.
JWT_SECRET_KEY=change-me-in-production-roe-dev-secret-key
JWT_ALGORITHM=HS256
JWT_ISSUER=roe
JWT_AUDIENCE=roe-api
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_HOURS=24
# For an external IdP (Auth0/Keycloak/Cognito) set JWT_ALGORITHM=RS256 and
# provide the signing certificate:
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Seed accounts, created only when the users table is empty.
BOOTSTRAP_ADMIN_EMAIL=admin@roe.app
BOOTSTRAP_ADMIN_PASSWORD=admin12345
BOOTSTRAP_DISPATCHER_EMAIL=dispatcher@roe.app
BOOTSTRAP_DISPATCHER_PASSWORD=dispatch12345

# --- External integrations (mock | http) -----------------------------------
OMS_ADAPTER=mock
# OMS_BASE_URL=https://oms.example.com/api
# OMS_API_KEY=
OMS_POLL_INTERVAL_SECONDS=15
OMS_UNAVAILABLE_THRESHOLD_SECONDS=60

FMS_ADAPTER=mock
# FMS_BASE_URL=https://fms.example.com/api
# FMS_API_KEY=
FMS_POLL_INTERVAL_SECONDS=15
FMS_UNAVAILABLE_THRESHOLD_SECONDS=30

# Valhalla-compatible geocoding + matrix service.
MAPPING_ADAPTER=mock
# MAPPING_BASE_URL=https://valhalla.example.com
# MAPPING_API_KEY=
MAPPING_UNAVAILABLE_THRESHOLD_SECONDS=30
MAPPING_RETRY_INTERVAL_SECONDS=60

DELIVERY_PLATFORM_ADAPTER=mock
# DELIVERY_PLATFORM_BASE_URL=https://delivery.example.com/api
# DELIVERY_PLATFORM_API_KEY=

# --- Optimisation ----------------------------------------------------------
OPTIMISATION_WALL_CLOCK_LIMIT_SECONDS=120
OPTIMISATION_SOLVER_LIMIT_SECONDS=110
OPTIMISATION_PROGRESS_INTERVAL_SECONDS=3
DEFAULT_SERVICE_DURATION_MIN=10
AVERAGE_SPEED_KMH=32

# --- Retention (minimums from Requirements 14.7, 16.2, 16.3) ---------------
AUDIT_RETENTION_DAYS=365
ROUTE_RETENTION_DAYS=365
ALERT_RETENTION_DAYS=90
